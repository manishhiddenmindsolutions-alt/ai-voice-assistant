# LiveKit Cloud Credentials (Sign up at https://livekit.io)
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Providers API Keys
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
SARVAM_API_KEY=your_sarvam_api_key

# PostgreSQL database URI (Docker Compose sets this automatically to 'db')
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/Voice-Agent

# Security (JWT token signing & data encryption)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_jwt_secret
# Generate via: python -c "import cryptography.fernet; print(cryptography.fernet.Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_32_byte_fernet_key

# Enable Background Voice Agent
ENABLE_BACKGROUND_AGENT=true
